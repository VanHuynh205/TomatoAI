!/PRODUCT.md
!/requirements-app.in
!/requirements-app.lock
!/docs/
!/docs/**
!/planning/
/planning/*
!/planning/tomato-desktop/
!/planning/tomato-desktop/**
!/_bmad-output/
!/_bmad-output/**
!/scripts/
!/scripts/**
!/tests/
!/tests/**
!/content/
!/content/**
!/artifacts/
!/artifacts/**
!/data/
/data/*
!/data/TomatoAI/
/data/TomatoAI/*
!/data/TomatoAI/data/
!/data/TomatoAI/data/**

# Agent instructions, skills, sessions, caches and credentials at any depth.
AGENTS.md
CLAUDE.md
GEMINI.md
SKILL.md
agents.md
claude.md
gemini.md
skill.md
.agents/
.codex/
