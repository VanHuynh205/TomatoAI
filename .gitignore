venv/
.env
.env.*
!.env.example
*.py[cod]
*.pem
*.key
*.pfx
*.p12
.DS_Store
Thumbs.db

# Keep phase reports and source; omit rebuildable binaries and downloads.
/artifacts/S01/build/
/artifacts/S01/dist/
/artifacts/S01/wheels/
/artifacts/S01/wheel-parts/
/artifacts/S01/qt-range-probe*.bin
