        "claim_ids": [],
        "project_sections": []
      },
      {
        "id": "understand",
        "text_vi": "Healthy trong bài chỉ là nhãn lớp lá. Ảnh lá không xác nhận tình trạng đất, rễ, nước, dinh dưỡng hoặc toàn cây. Chưa có review độc lập cho bài này.",
        "source_ids": [
          "project:localization"
        ],
        "card_pointers": [],
        "claim_ids": [],
        "project_sections": [
          "Hướng dẫn có ngữ cảnh và giới hạn"
        ]
      },
      {
        "id": "care",
        "text_vi": "Bản dịch nháp: Tưới vào gốc cây để giữ lá khô. Nguồn UMN nêu nguyên tắc hạn chế làm ướt lá; bài không đưa lượng nước, tần suất hay lịch bón phân. Chưa được phép hiển thị như lời khuyên.",
        "source_ids": [
          "healthy",
          "card:healthy"
        ],
        "card_pointers": [
          "/content_en/management/cultural/2"
        ],
        "claim_ids": [
