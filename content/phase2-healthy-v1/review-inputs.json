  "lesson": {
    "lesson_id": "lesson:healthy-leaf-watering:vi:v1",
    "status": "draft",
    "display_allowed": false,
    "title_vi": "Quan sát lá và đọc nguyên tắc tưới có nguồn",
    "objectives": [
      "Nhận ra màu xanh phù hợp giống và không thấy đốm là hai dấu hiệu tham khảo của lá.",
      "Nêu được giới hạn: nhãn lá khỏe không bảo đảm toàn cây khỏe hoặc đất, nước, phân đã phù hợp.",
      "Chọn được nguyên tắc tưới vào gốc để giữ lá khô và nêu nguồn; không suy lượng hoặc lịch tưới."
    ],
    "sections": [
      {
        "id": "observe",
        "text_vi": "Thẻ EN mô tả lá xanh phù hợp giống và không thấy đốm hoặc tổn thương. Đây là dấu hiệu quan sát tham khảo, không phải chẩn đoán toàn cây.",
        "source_ids": [
          "card:healthy"
        ],
        "card_pointers": [
          "/content_en/symptoms/leaves/0",
          "/content_en/symptoms/leaves/2"
